ANTHROPIC_BASE_URL=
MODEL_ID=
ANTHROPIC_API_KEY=
REQUIREMENT_PROMPT_VERSION=requirement-extraction-v1
REQUIREMENT_MAX_ATTEMPTS=2
REQUIREMENT_TIMEOUT_SECONDS=20
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
# 高德 JS API Key 与后端 Web 服务 Key 类型不同，只进入浏览器构建。
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# Phase 1 application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://routebook:routebook@localhost:5432/routebook
LANGGRAPH_DATABASE_URL=postgresql://routebook:routebook@localhost:5432/routebook?options=-csearch_path%3Dlanggraph
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
API_CORS_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000

# Provider reliability and normalized cache
PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PROVIDER_READ_TIMEOUT_SECONDS=8
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.2
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_TIMEOUT_SECONDS=0.25
POI_CACHE_TTL_SECONDS=2592000
GEOCODE_CACHE_TTL_SECONDS=2592000
ROUTE_CACHE_TTL_SECONDS=21600
WEATHER_DAILY_CACHE_TTL_SECONDS=3600
WEATHER_HOURLY_CACHE_TTL_SECONDS=1800
WEATHER_WARNING_CACHE_TTL_SECONDS=600
PROVIDER_STALE_TTL_SECONDS=86400
POI_AUTO_ADOPT_THRESHOLD=0.82
POI_MINIMUM_MARGIN=0.12
POI_CONFIRMATION_THRESHOLD=0.45
POI_EXACT_NAME_WEIGHT=0.48
POI_PARTIAL_NAME_WEIGHT=0.28
POI_ATTRACTION_WEIGHT=0.28
POI_UNKNOWN_SEMANTIC_WEIGHT=0.08
POI_REGION_MATCH_WEIGHT=0.14
POI_REGION_MISMATCH_PENALTY=0.25
POI_ADDRESS_WEIGHT=0.05
POI_ADCODE_WEIGHT=0.05
POI_HARD_FILTER_SCORE_CAP=0.20
