            "format": "uuid",
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "weather_refs": {
          "items": {
            "type": "string"
          },
          "title": "Weather Refs",
          "type": "array"
        }
      },
      "required": [
        "day_number"
